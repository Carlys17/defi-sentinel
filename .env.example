# ============================================
# DeFi Sentinel - Environment Configuration
# ============================================

# --- LLM Provider ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
# Or use Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- KeeperHub ---
KEEPERHUB_API_KEY=kh-your-key-here
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
KEEPERHUB_CHAIN=base_sepolia  # base_sepolia, arbitrum_sepolia, polygon_mumbai

# --- Wallet ---
# Uses KeeperHub Turnkey wallet (server-side custody) — no private key needed
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# --- Portfolio Config ---
PORTFOLIO_REBALANCE_THRESHOLD=5.0  # percentage deviation to trigger rebalance
LIQUIDATION_THRESHOLD=1.5  # health factor threshold to trigger alert
LIQUIDATION_CRITICAL=1.2  # health factor threshold for emergency action
MONITOR_INTERVAL_SECONDS=60  # how often to check portfolio

# --- Targets (Portfolio Allocation) ---
# Format: token_address:percentage, separated by semicolons
PORTFOLIO_TARGETS=0x0000000000000000000000000000000000000000:60;0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913:40

# --- Notification ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# --- Safety ---
MAX_TRANSACTION_USD=1000  # max single transaction in USD
AUTO_APPROVE_MAX_USD=100  # auto-approve transactions under this amount
BLOCK_THRESHOLD_USD=5000  # block transactions above this amount

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/sentinel.log