[44.960852, "o", "\u001b[36m╭─\u001b[0m\u001b[36m────────────────────────────────────────────────────────\u001b[0m\u001b[36m \u001b[0m\u001b[1;36m🏗  SYSTEM ARCHITECTURE\u001b[0m\u001b[36m \u001b[0m\u001b[36m────────────────────────────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1mDeFi Sentinel Architecture\u001b[0m                                                                                                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m   \u001b[1msrc/agent/core.py\u001b[0m       → LLM reasoning + decision synthesis                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m   \u001b[1msrc/strategies/liquidation_shield.py\u001b[0m → Real-time HF monitoring + auto-protection                                                       \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m   \u001b[1msrc/strategies/yield_optimizer.py\u001b[0m → Cross-protocol APY comparison                                                                      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m   \u001b[1msrc/strategies/rebalancer.py\u001b[0m → Target allocation enforcement                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m   \u001b[1msrc/keeperhub/client.py\u001b[0m  → On-chain execution (simulation + broadcast)                                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m   \u001b[1msrc/notifications/\u001b[0m       → Telegram + Discord alerts                                                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m   \u001b[1msrc/observability/audit.py\u001b[0m → Immutable action trail                             