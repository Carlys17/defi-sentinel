           \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m      \u001b[0m\u001b[91;40m\"parameters\"\u001b[0m\u001b[97;40m:\u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m{\u001b[0m\u001b[40m                                                                                                                   \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m        \u001b[0m\u001b[91;40m\"protocol\"\u001b[0m\u001b[97;40m:\u001b[0m\u001b[97;40m \u001b[0m\u001b[93;40m\"Aave V3\"\u001b[0m\u001b[97;40m,\u001b[0m\u001b[40m                                                                                                          \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m        \u001b[0m\u001b[91;40m\"asset\"\u001b[0m\u001b[97;40m:\u001b[0m\u001b[97;40m \u001b[0m\u001b[93;40m\"USDC\"\u001b[0m\u001b[97;40m,\u001b[0m\u001b[40m                                                                                                                \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m        \u001b[0m\u001b[91;40m\"amount\"\u001b[0m\u001b[97;40m:\u001b[0m\u001b[97;40m \u001b[0m\u001b[93;40m\"2000.00\"\u001b[0m\u001b[97;40m,\u001b[0m\u001b[40m                                                                                                            \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m        \u001b[0m\u001b[91;40m\"underlying_collateral\"\u001b[0m\u001b[97;40m:\u001b[0m\u001b[97;40m \u001b[0m\u001b[93;40m\"WETH\"\u001b[0m\u001b[40m                                                                                                 \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m      \u001b[0m\u001b[97;40m},\u001b[0m\u001b[40m                                                                                                                                \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m      \u001b[0m\u001b[91;40m\"estimated_usd_impact\"\u001b[0m\u001b[97;40m:\u001b[0m\u001b[97;40m \u001b[0m\u001b[37;40m-2000.0\u001b[0m\u001b[97;40m,\u001b[0m\u001b[40m                                                                                                  \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m      \u001b[0m\u001b[91;40m\"requires_approval\"\u001b[0m\u001b[97;40m:\u001b[0m\u001b[97;40m \u001b[0m\u001b[96;40mfalse\u001b[0m\u001b[97;40m,\u001b[0m\u001b[40m                                                                                                       \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m      \u001b[0m\u001b[91;40m\"strategy\"\u001b[0m\u001b[97;40m:\u001b[0m\u001b[97;40m \u001b[0m\u001b[93;40m\"liquidation_shield\"\u001b[0m\u001b[40m                                                                                                  \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[97;40m    \u001b[0m\u001b[97;40m},\u001b[0m\u001b[40m                                                                                                                                  \u001b[0m \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0"]
